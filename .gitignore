# Môi trường ảo và cache Python
.venv/
venv/
__pycache__/
*.py[cod]
.ipynb_checkpoints/
.pytest_cache/
# Dữ liệu gốc dung lượng lớn (~700 MB): không đưa lên Git.
# Tải bằng: python src/download_data.py (xem README.md)
data/raw/

# Mô hình/checkpoint lớn: lưu trên Drive/Hugging Face và ghi link trong README
models/*
!models/scaler_*.pkl
!models/.gitkeep

# Tệp hệ thống / IDE
.DS_Store
Thumbs.db
.vscode/
.idea/
data/processed/candidates_hourly.csv

# Bản sao lưu tạm trong quá trình thí nghiệm: giữ trên máy, không đưa lên Git.
# results/luu_tam/     - bản MLP ở các cấu hình đã bị thay thế
# results/analysis_cal0/ - bản phân tích "trước khi cải tiến", đã bị thay thế
# Mọi chỉ số của các cấu hình này vẫn còn trong results/experiments.csv.
results/luu_tam/
results/analysis_cal0/

# Báo cáo Word: nộp và chia sẻ riêng, không đưa lên Git (tệp nhị phân,
# Git không diff được và mỗi lần sửa lại thêm ~1 MB vào lịch sử).
*.docx
*.doc
~$*.docx
