   "outputs": [],
   "source": [
    "d_train = {}\n",
    "scaler_info = []\n",
    "for c in CHAINS:\n",
    "    d_train[c] = calculate_d_train(train_df[c].to_numpy(dtype=float))\n",
    "    if not np.isfinite(d_train[c]) or d_train[c] <= 0:\n",
    "        raise ValueError(f\"d_train không hợp lệ cho {c}: {d_train[c]}\")\n",
    "\n",
    "    scaler = StandardScaler().fit(train_df[[c]].to_numpy())   # ép 1 cột, chỉ trên train\n",
