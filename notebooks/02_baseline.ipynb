   "source": [
    "import sys\n",
    "import os\n",
    "\n",
    "# 1. Đưa thư mục gốc dự án vào sys.path và chuyển Working Directory về thư mục gốc\n",
    "if os.path.basename(os.getcwd()) == \"notebooks\":\n",
    "    os.chdir(\"..\")\n",
    "project_root = os.path.abspath(\".\")\n",
    "if project_root not in sys.path:\n",
    "    sys.path.insert(0, project_root)\n",
    "\n",
    "import joblib\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.preprocessing import StandardScaler\n",
    "\n",
    "from src.baseline import (\n",
    "    BASELINE_COLUMNS,\n",
    "    get_common_eval_timestamps,\n",
    "    predict_baselines,\n",
    ")\n",
    "from src.data import load_hourly_data, load_splits\n",
    "from src.metrics import (\n",
    "    calculate_d_train,\n",
    "    evaluate_forecast,\n",
    "    evaluate_by_group,\n",
    ")\n",
    "\n",
    "# ============================================================\n",
    "# 0. THIẾT LẬP\n",
    "# ============================================================\n",
    "\n",
    "plt.style.use(\n",
    "    \"seaborn-v0_8-whitegrid\"\n",
    "    if \"seaborn-v0_8-whitegrid\" in plt.style.available\n",
    "    else \"default\"\n",
    ")\n",
    "plt.rcParams[\"font.sans-serif\"] = [\"DejaVu Sans\", \"Arial\"]\n",
    "plt.rcParams[\"axes.unicode_minus\"] = False\n",
    "sns.set_theme(style=\"whitegrid\")\n",
    "\n",
    "CUSTOMER_COL = \"MT_158\"\n",
    "\n",
    "os.makedirs(\"results/tables\", exist_ok=True)\n",
    "os.makedirs(\"results/figures\", exist_ok=True)\n",
    "os.makedirs(\"models\", exist_ok=True)\n",
    "\n",
    "# ============================================================\n",
    "# 1. ĐỌC DỮ LIỆU VÀ CÁC TẬP ĐÃ CHIA\n",
    "# ============================================================\n",
    "\n",
    "full_df = load_hourly_data(customers=[CUSTOMER_COL])\n",
    "splits = load_splits(customers=[CUSTOMER_COL])\n",
    "\n",
    "full_series = full_df[CUSTOMER_COL].astype(float).sort_index()\n",
    "train_series = splits[\"train\"][CUSTOMER_COL].astype(float).sort_index()\n",
    "val_series = splits[\"validation\"][CUSTOMER_COL].astype(float).sort_index()\n",
    "test_series = splits[\"test\"][CUSTOMER_COL].astype(float).sort_index()\n",
    "\n",
    "print(f\"Chuỗi dữ liệu: {CUSTOMER_COL}\")\n",
    "print(\n",
    "    f\"Train: {len(train_series)} giờ | \"\n",
    "    f\"Validation: {len(val_series)} giờ | \"\n",
    "    f\"Test: {len(test_series)} giờ\"\n",
    ")\n",
    "\n",
    "for split_name, split_series in [\n",
    "    (\"Train\", train_series),\n",
    "    (\"Validation\", val_series),\n",
    "    (\"Test\", test_series),\n",
    "]:\n",
    "    if not split_series.index.isin(full_series.index).all():\n",
    "        raise ValueError(\n",
    "            f\"{split_name} có timestamp không tồn tại trong full_series.\"\n",
    "        )\n",
    "\n",
    "# ============================================================\n",
    "# 2. TÍNH d_train TRÊN TRAIN GỐC (DÙNG CHO MASE)\n",
    "# ============================================================\n",
    "\n",
    "d_train = calculate_d_train(train_series.to_numpy(dtype=float))\n",
    "if not np.isfinite(d_train) or d_train <= 0:\n",
    "    raise ValueError(\n",
    "        f\"d_train không hợp lệ ({d_train}); không thể tính MASE.\"\n",
    "    )\n",
    "print(f\"d_train = {d_train:.6f}\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 3. FIT SCALER TRÊN TRAIN\n",
    "# ============================================================\n",
    "# Scaler riêng cho từng chuỗi dữ liệu.\n",
    "# Chỉ fit trên tập Train, không sử dụng Validation/Test.\n",
    "\n",
    "scaler = StandardScaler()\n",
    "scaler.fit(train_series.to_frame())\n",
    "\n",
    "scaler_path = f\"models/scaler_{CUSTOMER_COL}.pkl\"\n",
    "joblib.dump(scaler, scaler_path)\n",
    "\n",
    "print(f\"Đã lưu {scaler_path}\")\n",
    "\n",
    "\n",
    "# ============================================================\n",
    "# 4. TẠO TIMESTAMP ĐÁNH GIÁ\n",
    "# ============================================================\n",
    "\n",
    "val_eval_timestamps = get_common_eval_timestamps(\n",
    "    full_series, val_series.index\n",
    ")\n",
    "test_eval_timestamps = get_common_eval_timestamps(\n",
    "    full_series, test_series.index\n",
    ")\n",
    "\n",
    "if len(val_eval_timestamps) == 0:\n",
    "    raise ValueError(\"Không có timestamp hợp lệ trong Validation.\")\n",
    "if len(test_eval_timestamps) == 0:\n",
    "    raise ValueError(\"Không có timestamp hợp lệ trong Test.\")\n",
    "\n",
    "print(\"Số timestamp Validation:\", len(val_eval_timestamps))\n",
    "print(\"Số timestamp Test:\", len(test_eval_timestamps))\n",
    "\n",
    "# ============================================================\n",
    "# 5. DỰ BÁO VÀ ĐÁNH GIÁ VALIDATION\n",
    "# ============================================================\n",
    "\n",
    "val_predictions = predict_baselines(full_series, val_eval_timestamps)\n",
    "val_metrics = {}\n",
    "\n",
    "for col in BASELINE_COLUMNS:\n",
    "    y_true = val_predictions[\"y_true\"].to_numpy(dtype=float)\n",
    "    y_pred = val_predictions[col].to_numpy(dtype=float)\n",
    "\n",
    "    if len(y_true) != len(y_pred):\n",
    "        raise ValueError(f\"Độ dài dữ liệu không khớp ở {col}.\")\n",
    "    if not np.isfinite(y_true).all() or not np.isfinite(y_pred).all():\n",
    "        raise ValueError(f\"Có NaN/Inf trong dự báo Validation: {col}.\")\n",
    "\n",
    "    val_metrics[col] = evaluate_forecast(y_true, y_pred, d_train=d_train)\n",
    "\n",
    "df_val_results = pd.DataFrame(val_metrics).T\n",
    "df_val_results.index.name = \"model\"\n",
    "\n",
    "if \"MAE\" not in df_val_results.columns:\n",
    "    raise KeyError(\"Không tìm thấy cột MAE trong kết quả đánh giá.\")\n",
    "\n",
    "# Chỉ chọn mô hình bằng MAE trên Validation, không chọn theo Test\n",
    "df_val_results = df_val_results.sort_values(\"MAE\")\n",
    "best_model = df_val_results.index[0]\n",
    "\n",
    "print(\"\\n=== KẾT QUẢ VALIDATION (xếp theo MAE tăng dần) ===\")\n",
    "display(df_val_results)\n",
    "print(f\"\\nMô hình được chọn theo MAE Validation: {best_model}\")\n",
    "\n",
    "# ============================================================\n",
    "# 6. DỰ BÁO VÀ ĐÁNH GIÁ TEST\n",
    "# Test chỉ dùng để báo cáo đánh giá cuối cùng\n",
    "# ============================================================\n",
    "\n",
    "test_predictions = predict_baselines(full_series, test_eval_timestamps)\n",
    "test_metrics_all = {}\n",
    "\n",
    "for col in BASELINE_COLUMNS:\n",
    "    y_true_test_col = test_predictions[\"y_true\"].to_numpy(dtype=float)\n",
    "    y_pred_test_col = test_predictions[col].to_numpy(dtype=float)\n",
    "\n",
    "    if not np.isfinite(y_true_test_col).all():\n",
    "        raise ValueError(\"Có NaN/Inf trong nhãn Test.\")\n",
    "    if not np.isfinite(y_pred_test_col).all():\n",
    "        raise ValueError(f\"Có NaN/Inf trong dự báo Test: {col}.\")\n",
    "\n",
    "    test_metrics_all[col] = evaluate_forecast(\n",
    "        y_true_test_col, y_pred_test_col, d_train=d_train\n",
    "    )\n",
    "\n",
    "df_test_results = pd.DataFrame(test_metrics_all).T\n",
    "df_test_results.index.name = \"model\"\n",
    "\n",
    "print(f\"\\n=== KẾT QUẢ TEST CỦA MÔ HÌNH ĐÃ CHỌN: {best_model} ===\")\n",
    "display(df_test_results.loc[[best_model]])\n",
    "print(\"\\n=== KẾT QUẢ TEST CỦA TẤT CẢ BASELINE (tham khảo) ===\")\n",
    "display(df_test_results)\n",
    "\n",
    "# ============================================================\n",
    "# 7. PHÂN TÍCH SAI SỐ THEO GIỜ VÀ THỨ TRONG TUẦN\n",
    "# ============================================================\n",
    "\n",
    "y_true_test = test_predictions[\"y_true\"].to_numpy(dtype=float)\n",
    "y_pred_best = test_predictions[best_model].to_numpy(dtype=float)\n",
    "test_ts = pd.DatetimeIndex(pd.to_datetime(test_predictions[\"timestamp\"]))\n",
    "\n",
    "df_group_eval = test_predictions.copy()\n",
    "df_group_eval[\"timestamp\"] = pd.to_datetime(df_group_eval[\"timestamp\"])\n",
    "\n",
    "df_error_by_hour = evaluate_by_group(\n",
    "    df_group_eval, pred_col=best_model, group_by=\"hour\"\n",
    ")\n",
    "df_error_by_dow = evaluate_by_group(\n",
    "    df_group_eval, pred_col=best_model, group_by=\"dayofweek\"\n",
    ")\n",
    "\n",
    "print(\"\\n=== SAI SỐ THEO GIỜ ===\")\n",
    "display(df_error_by_hour)\n",
    "print(\"\\n=== SAI SỐ THEO THỨ TRONG TUẦN (0=Thứ Hai, 6=Chủ Nhật) ===\")\n",
    "display(df_error_by_dow)\n",
    "\n",
    "# Bảng residual: residual = thực tế - dự báo\n",
    "df_errors = pd.DataFrame({\n",
    "    \"timestamp\": test_ts,\n",
    "    \"y_true\": y_true_test,\n",
    "    \"y_pred\": y_pred_best,\n",
    "})\n",
    "df_errors[\"residual\"] = df_errors[\"y_true\"] - df_errors[\"y_pred\"]\n",
    "df_errors[\"abs_error\"] = df_errors[\"residual\"].abs()\n",
    "\n",
    "# Top 10 sai số tuyệt đối lớn nhất\n",
    "top10_worst = df_errors.nlargest(10, \"abs_error\").reset_index(drop=True)\n",
    "print(\"\\n=== TOP 10 DỰ BÁO CÓ SAI SỐ TUYỆT ĐỐI LỚN NHẤT ===\")\n",
    "display(top10_worst)\n",
    "\n",
    "# ============================================================\n",
    "# 8. BIỂU ĐỒ MAE VALIDATION (TÁCH RIÊNG)\n",
    "# ============================================================\n",
    "\n",
    "val_plot = df_val_results.reset_index()\n",
    "\n",
    "plt.figure(figsize=(9, 5))\n",
    "sns.barplot(data=val_plot, x=\"model\", y=\"MAE\", color=\"steelblue\")\n",
    "plt.title(\"So sánh MAE của các Baseline - Validation\")\n",
    "plt.xlabel(\"Mô hình Baseline\")\n",
    "plt.ylabel(\"MAE\")\n",
    "plt.xticks(rotation=15, ha=\"right\")\n",
    "plt.tight_layout()\n",
    "plt.savefig(\"results/figures/baseline_val_mae.png\", dpi=300, bbox_inches=\"tight\")\n",
    "plt.show()\n",
    "plt.close()\n",
    "\n",
    "# ============================================================\n",
    "# 9. BIỂU ĐỒ RMSE VALIDATION (TÁCH RIÊNG)\n",
    "# ============================================================\n",
    "\n",
    "plt.figure(figsize=(9, 5))\n",
    "sns.barplot(data=val_plot, x=\"model\", y=\"RMSE\", color=\"darkorange\")\n",
    "plt.title(\"So sánh RMSE của các Baseline - Validation\")\n",
    "plt.xlabel(\"Mô hình Baseline\")\n",
    "plt.ylabel(\"RMSE\")\n",
    "plt.xticks(rotation=15, ha=\"right\")\n",
    "plt.tight_layout()\n",
