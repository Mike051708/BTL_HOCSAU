    "            \"y_snaive24\": s.iloc[p - 24],\n",
    "            \"y_snaive168\": s.iloc[p - 168],\n",
    "        }\n",
    "        bad += sum(not np.isclose(pred.loc[i, k], v) for k, v in expected.items())\n",
    "    print(f\"{c}: 300 mẫu x 5 cột, số giá trị sai = {bad}\")\n",
    "    assert bad == 0"
